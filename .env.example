GEMINI_API_KEY=replace_with_your_own_key_locally
# List current IDs: python -m flask --app app list-gemini-models
# Verified working on 2026-11-17: gemini-3.1-flash-lite (larger flash models were overloaded/timing out)
GEMINI_MODEL=replace_with_a_model_verified_for_your_account
# Optional: real models tried in order if the primary is overloaded (503/504) or times out
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Optional: per-request timeout in milliseconds (default 30000)
GEMINI_TIMEOUT_MS=30000
FLASK_DEBUG=false
